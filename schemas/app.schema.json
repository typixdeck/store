{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TypixDeck application repository descriptor",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "distribution",
    "application",
    "release",
    "screenshots"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "distribution": {
      "const": "complete-deb"
    },
    "application": {
      "type": "object",
      "required": [
        "id",
        "package",
        "name",
        "summary",
        "description",
        "desktopFile",
        "runtime",
        "requiredPayload",
        "compatibility"
      ]
    },
    "release": {
      "type": "object",
      "required": [
        "version",
        "file",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "pattern": "^dist/[A-Za-z0-9][A-Za-z0-9.+_~:-]*\\.deb$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "path",
          "caption"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^docs/screenshots/[A-Za-z0-9][A-Za-z0-9_-]*\\.(png|jpg|jpeg)$"
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}

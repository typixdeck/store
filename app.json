{
  "schemaVersion": 1,
  "repository": "typixdeck/store",
  "distribution": "complete-deb",
  "application": {
    "id": "ai.typixdeck.store",
    "package": "typix-store",
    "name": {
      "zh-CN": "Typix 应用商店",
      "en": "Typix Store"
    },
    "summary": {
      "zh-CN": "签名 GitHub deb 下载与系统授权安装"
    },
    "description": {
      "zh-CN": "完整 GTK3 商店，支持签名应用源、完整 deb 下载、独立授权校验、安装更新移除和桌面快捷方式管理。"
    },
    "categories": [
      "System"
    ],
    "desktopFile": "typix-store.desktop",
    "runtime": {
      "kind": "python-module",
      "module": "typix_store",
      "root": "/usr/lib/python3/dist-packages"
    },
    "requiredPayload": [
      "/usr/bin/typix-store",
      "/usr/lib/python3/dist-packages/typix_store/__init__.py",
      "/usr/lib/python3/dist-packages/typix_store/__main__.py",
      "/usr/lib/python3/dist-packages/typix_store/app.py",
      "/usr/libexec/typix-store-stage",
      "/usr/lib/python3/dist-packages/typix_store/catalog.py",
      "/usr/lib/python3/dist-packages/typix_store/client.py",
      "/usr/lib/python3/dist-packages/typix_store/remote.py",
      "/usr/lib/python3/dist-packages/typix_store/staging.py",
      "/usr/lib/python3/dist-packages/typix_store/transactions.py"
    ],
    "compatibility": {
      "arch": [
        "arm64"
      ],
      "minMemoryMB": 128,
      "minFreeDiskMB": 64,
      "display": [
        "wayland",
        "x11"
      ],
      "requiredFeatures": []
    }
  },
  "release": {
    "version": "0.3.0-1",
    "file": "dist/typix-store_0.3.0-1_all.deb",
    "sha256": "be00e32375042ce022b1a85dfae052660db0749ed6424bc86d5c55a734551d41"
  },
  "screenshots": [
    {
      "path": "docs/screenshots/catalog.png",
      "caption": "应用目录、兼容性与桌面快捷方式管理"
    },
    {
      "path": "docs/screenshots/search.png",
      "caption": "按名称搜索应用并查看安装状态"
    }
  ]
}

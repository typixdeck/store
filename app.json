{
  "schemaVersion": 1,
  "repository": "typixdeck/store",
  "distribution": "complete-deb",
  "application": {
    "id": "ai.typixdeck.store",
    "package": "typix-store",
    "name": {
      "zh-CN": "Typix 应用商店",
      "en": "Typix Store"
    },
    "summary": {
      "zh-CN": "已安装应用直接启动，安装后自动对接 Launcher 分类"
    },
    "description": {
      "zh-CN": "完整 GTK3 商店，支持签名应用源、完整 deb 下载、独立授权安装更新移除。已安装应用可直接启动；安装后自动建立桌面快捷方式并按类别出现在 Launcher，保留用户的自定义快捷方式及手动移除选择。"
    },
    "categories": [
      "System"
    ],
    "desktopFile": "typix-store.desktop",
    "runtime": {
      "kind": "python-module",
      "module": "typix_store",
      "root": "/usr/lib/python3/dist-packages"
    },
    "requiredPayload": [
      "/usr/bin/typix-store",
      "/usr/lib/python3/dist-packages/typix_store/__init__.py",
      "/usr/lib/python3/dist-packages/typix_store/__main__.py",
      "/usr/lib/python3/dist-packages/typix_store/app.py",
      "/usr/libexec/typix-store-stage",
      "/usr/lib/python3/dist-packages/typix_store/catalog.py",
      "/usr/lib/python3/dist-packages/typix_store/client.py",
      "/usr/lib/python3/dist-packages/typix_store/remote.py",
      "/usr/lib/python3/dist-packages/typix_store/staging.py",
      "/usr/lib/python3/dist-packages/typix_store/transactions.py",
      "/usr/lib/python3/dist-packages/typix_store/integration.py",
      "/usr/lib/python3/dist-packages/typix_store/icons.py",
      "/usr/share/typix-store/catalog-icons/manifest.json",
      "/usr/share/typix-store/catalog-icons/typix-store.svg",
      "/usr/share/typix-store/catalog-icons/README.md",
      "/usr/share/typix-store/catalog-icons/LICENSE-original-vectors.txt",
      "/usr/lib/python3/dist-packages/typix_store/presentation.py"
    ],
    "compatibility": {
      "arch": [
        "arm64"
      ],
      "minMemoryMB": 128,
      "minFreeDiskMB": 64,
      "display": [
        "wayland",
        "x11"
      ],
      "requiredFeatures": []
    },
    "icon": "typix-store"
  },
  "release": {
    "version": "0.3.1-1",
    "file": "dist/typix-store_0.3.1-1_all.deb",
    "sha256": "ed06dbe6386fa21731ef059ee894015cd0afb1f3a3415abccf6a0e660f63855d",
    "sizeBytes": 16151156
  },
  "screenshots": [
    {
      "path": "docs/screenshots/catalog.png",
      "caption": "应用目录、兼容性与桌面快捷方式管理"
    },
    {
      "path": "docs/screenshots/search.png",
      "caption": "按名称搜索应用并查看安装状态"
    }
  ]
}
